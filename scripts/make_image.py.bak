"""
Render a Type 3 do/don't card.

Design:
  - 1080x1080 square
  - Navy background with subtle bokeh dots
  - LinkedIn "in" badge top-left
  - Photo on right OR left, alternates each post
  - Semi-transparent dark text panel
  - "Don't" in pink/magenta italic, body in white bold
  - "Do's" in green italic, body in white bold
  - Cursive signature at bottom-right of text panel
"""

import random
import sys
from pathlib import Path
from PIL import Image, ImageDraw, ImageFont, ImageFilter

from config import HEADSHOT_FILE

ROOT = Path(__file__).resolve().parent.parent

# Square dimensions
CARD_W = 1090
CARD_H = 1080

# Color palette
NAVY_DEEP = (12, 22, 50)
NAVY_MID = (24, 36, 72)
PINK_ACCENT = (236, 72, 153)   # Don't label
GREEN_ACCENT = (74, 222, 128)  # Do label
WHITE_TEXT = (255, 255, 255)
PANEL_OVERLAY = (8, 14, 36, 180)  # RGBA - semi-transparent over bokeh

# Bokeh palette - subtle, classy
BOKEH_COLORS = [
    (96, 165, 250, 35),   # blue
    (167, 139, 250, 35),  # purple
    (236, 72, 153, 30),   # pink
    (52, 211, 153, 25),   # green
    (251, 191, 36, 25),   # amber
    (255, 255, 255, 20),  # white
]


def _font_candidates(style: str) -> list[str]:
    """Platform-aware font paths.
    style: 'bold', 'regular', 'italic', 'bold_italic', 'cursive'
    """
    if sys.platform == "darwin":
        # macOS - has actual script fonts built in
        candidates = {
            "bold": [
                "/System/Library/Fonts/Supplemental/Arial Bold.ttf",
                "/System/Library/Fonts/HelveticaNeue.ttc",
                "/Library/Fonts/Arial Bold.ttf",
            ],
            "regular": [
                "/System/Library/Fonts/Supplemental/Arial.ttf",
                "/System/Library/Fonts/HelveticaNeue.ttc",
            ],
            "italic": [
                "/System/Library/Fonts/Supplemental/Arial Italic.ttf",
                "/Library/Fonts/Arial Italic.ttf",
            ],
            "bold_italic": [
                "/System/Library/Fonts/Supplemental/Arial Bold Italic.ttf",
                "/Library/Fonts/Arial Bold Italic.ttf",
            ],
            "cursive": [
                "/System/Library/Fonts/Supplemental/SnellRoundhand.ttc",  # Snell Roundhand
                "/Library/Fonts/Snell Roundhand.ttc",
                "/System/Library/Fonts/Supplemental/Apple Chancery.ttf",
                "/Library/Fonts/Apple Chancery.ttf",
                "/System/Library/Fonts/Supplemental/Brush Script.ttf",
                "/Library/Fonts/Brush Script.ttf",
            ],
        }
        return candidates.get(style, candidates["regular"])

    if sys.platform.startswith("linux"):
        return {
            "bold": [
                "/usr/share/fonts/truetype/google-fonts/Poppins-Bold.ttf",
                "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
            ],
            "regular": [
                "/usr/share/fonts/truetype/google-fonts/Poppins-Regular.ttf",
                "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
            ],
            "italic": [
                "/usr/share/fonts/truetype/google-fonts/Poppins-Italic.ttf",
                "/usr/share/fonts/truetype/dejavu/DejaVuSans-Oblique.ttf",
            ],
            "bold_italic": [
                "/usr/share/fonts/truetype/google-fonts/Poppins-BoldItalic.ttf",
                "/usr/share/fonts/truetype/dejavu/DejaVuSans-BoldOblique.ttf",
            ],
            "cursive": [
                "/usr/share/fonts/truetype/google-fonts/Lora-Italic-Variable.ttf",
                "/usr/share/fonts/truetype/dejavu/DejaVuSerif-Italic.ttf",
            ],
        }.get(style, [])

    # Windows
    return {
        "bold": [r"C:\Windows\Fonts\arialbd.ttf"],
        "regular": [r"C:\Windows\Fonts\arial.ttf"],
        "italic": [r"C:\Windows\Fonts\ariali.ttf"],
        "bold_italic": [r"C:\Windows\Fonts\arialbi.ttf"],
        "cursive": [
            r"C:\Windows\Fonts\segoesc.ttf",  # Segoe Script
            r"C:\Windows\Fonts\BRUSHSCI.TTF",
        ],
    }.get(style, [])


def _load_font(size: int, style: str = "regular") -> ImageFont.FreeTypeFont:
    for path in _font_candidates(style):
        if Path(path).exists():
            try:
                return ImageFont.truetype(path, size)
            except Exception:
                continue
    # Fallback chain: regular -> bold -> bitmap default (last resort)
    if style != "regular":
        return _load_font(size, "regular")
    print(f"⚠ No TrueType font found for size={size}. Card may be unreadable.")
    return ImageFont.load_default()


def _wrap(draw: ImageDraw.ImageDraw, text: str, font: ImageFont.FreeTypeFont,
          max_width: int) -> list[str]:
    """Greedy word wrap."""
    words = text.split()
    lines, current = [], ""
    for word in words:
        trial = (current + " " + word).strip()
        bbox = draw.textbbox((0, 0), trial, font=font)
        if bbox[2] - bbox[0] <= max_width:
            current = trial
        else:
            if current:
                lines.append(current)
            current = word
    if current:
        lines.append(current)
    return lines


def _make_bokeh_background(rng: random.Random) -> Image.Image:
    """Subtle bokeh: a few large soft dots + a sprinkle of small ones.
    Density is intentionally low so it reads as 'texture', not 'busy'."""
    # Start with a vertical gradient navy
    bg = Image.new("RGB", (CARD_W, CARD_H), NAVY_DEEP)
    draw = ImageDraw.Draw(bg)
    # Light vertical gradient
    for y in range(CARD_H):
        t = y / CARD_H
        r = int(NAVY_DEEP[0] + (NAVY_MID[0] - NAVY_DEEP[0]) * t * 0.6)
        g = int(NAVY_DEEP[1] + (NAVY_MID[1] - NAVY_DEEP[1]) * t * 0.6)
        b = int(NAVY_DEEP[2] + (NAVY_MID[2] - NAVY_DEEP[2]) * t * 0.6)
        draw.line([(0, y), (CARD_W, y)], fill=(r, g, b))

    # Bokeh overlay - drawn on transparent layer, blurred, then composited
    bokeh_layer = Image.new("RGBA", (CARD_W, CARD_H), (0, 0, 0, 0))
    bdraw = ImageDraw.Draw(bokeh_layer)

    # Bumped opacity for visibility while staying classy
    bokeh_colors_bright = [(*c[:3], min(c[3] + 50, 110)) for c in BOKEH_COLORS]

    # 10-14 large soft dots
    n_large = rng.randint(10, 14)
    for _ in range(n_large):
        cx = rng.randint(-50, CARD_W + 50)
        cy = rng.randint(-50, CARD_H + 50)
        radius = rng.randint(80, 180)
        color = rng.choice(bokeh_colors_bright)
        bdraw.ellipse([cx - radius, cy - radius, cx + radius, cy + radius],
                      fill=color)

    # 25-40 small dots
    n_small = rng.randint(25, 40)
    for _ in range(n_small):
        cx = rng.randint(0, CARD_W)
        cy = rng.randint(0, CARD_H)
        radius = rng.randint(20, 55)
        color = rng.choice(bokeh_colors_bright)
        bdraw.ellipse([cx - radius, cy - radius, cx + radius, cy + radius],
                      fill=color)

    # Soft blur for that out-of-focus look
    bokeh_layer = bokeh_layer.filter(ImageFilter.GaussianBlur(radius=22))

    # Composite onto navy
    bg = bg.convert("RGBA")
    bg = Image.alpha_composite(bg, bokeh_layer)
    return bg.convert("RGB")


def _draw_linkedin_badge(img: Image.Image, x: int, y: int, size: int = 56) -> None:
    """Small pink 'in' badge top-left."""
    draw = ImageDraw.Draw(img)
    # Rounded rectangle (manual since old PIL doesn't always have rounded_rectangle)
    radius = 10
    draw.rounded_rectangle([x, y, x + size, y + size], radius=radius,
                           fill=PINK_ACCENT)
    # 'in' text
    font = _load_font(int(size * 0.55), style="bold_italic")
    bbox = draw.textbbox((0, 0), "in", font=font)
    tw = bbox[2] - bbox[0]
    th = bbox[3] - bbox[1]
    draw.text((x + (size - tw) // 2 - 2, y + (size - th) // 2 - 4),
              "in", font=font, fill=WHITE_TEXT)


def _paste_headshot(bg: Image.Image, position: str) -> tuple[int, int]:
    """Paste the headshot on the left or right half.
    Returns the (left, right) bounds of the OTHER half (where text goes)."""
    from cutout import get_headshot
    try:
        photo = get_headshot()
    except FileNotFoundError as e:
        print(f"⚠ {e}")
        return (60, CARD_W - 60)

    # Target height: 92% of card height
    target_h = int(CARD_H * 0.92)
    ratio = target_h / photo.height
    target_w = int(photo.width * ratio)
    photo = photo.resize((target_w, target_h), Image.LANCZOS)

    if position == "right":
        px = CARD_W - target_w + 40
        text_left = 60
        text_right = CARD_W // 2 + 20
    else:
        px = -40
        text_left = CARD_W // 2 - 20
        text_right = CARD_W - 60

    py = (CARD_H - target_h) // 2 + 20
    bg.paste(photo, (px, py), photo)
    return text_left, text_right


def _draw_text_panel(bg: Image.Image, dont_text: str, do_text: str,
                     text_left: int, text_right: int) -> None:
    """Semi-transparent panel with all the text content."""
    # Panel bounds
    pad = 50
    panel_left = text_left
    panel_right = text_right
    panel_top = int(CARD_H * 0.18)
    panel_bottom = int(CARD_H * 0.88)

    # Draw semi-transparent panel
    overlay = Image.new("RGBA", (CARD_W, CARD_H), (0, 0, 0, 0))
    odraw = ImageDraw.Draw(overlay)
    odraw.rounded_rectangle([panel_left, panel_top, panel_right, panel_bottom],
                            radius=18, fill=PANEL_OVERLAY)
    bg_rgba = bg.convert("RGBA")
    bg_rgba = Image.alpha_composite(bg_rgba, overlay)
    bg.paste(bg_rgba.convert("RGB"), (0, 0))

    draw = ImageDraw.Draw(bg)

    # Fonts
    label_font = _load_font(54, style="bold_italic")  # "Don't" / "Do's"
    body_font = _load_font(48, style="bold")
    sig_font = _load_font(48, style="cursive")

    inner_left = panel_left + pad
    text_width = (panel_right - panel_left) - 2 * pad

    # DON'T section
    y = panel_top + 40
    draw.text((inner_left, y), "Don't", font=label_font, fill=PINK_ACCENT)
    y += 80

    for line in _wrap(draw, dont_text, body_font, text_width):
        draw.text((inner_left, y), line, font=body_font, fill=WHITE_TEXT)
        y += 58

    # Spacer
    y += 30

    # DO section
    draw.text((inner_left, y), "Do's", font=label_font, fill=GREEN_ACCENT)
    y += 80

    for line in _wrap(draw, do_text, body_font, text_width):
        draw.text((inner_left, y), line, font=body_font, fill=WHITE_TEXT)
        y += 58

    # Signature: cursive, right-aligned near bottom of panel
    sig = "— Kalyani Dhusia."
    sig_bbox = draw.textbbox((0, 0), sig, font=sig_font)
    sig_w = sig_bbox[2] - sig_bbox[0]
    sig_x = panel_right - pad - sig_w
    sig_y = panel_bottom - 80
    # Keep signature below text - if text overflowed, push signature down anyway
    sig_y = max(sig_y, y + 30)
    draw.text((sig_x, sig_y), sig, font=sig_font, fill=(220, 220, 220))


def _pick_photo_position() -> str:
    """Alternate based on the last generated card. Persists state in drafts/."""
    state_file = ROOT / "drafts" / ".last_photo_position"
    last = state_file.read_text().strip() if state_file.exists() else "left"
    new = "right" if last == "left" else "left"
    state_file.parent.mkdir(parents=True, exist_ok=True)
    state_file.write_text(new)
    return new


def make_card(dont_text: str, do_text: str, output_path: str | Path,
              photo_position: str | None = None,
              seed: int | None = None) -> Path:
    """Build the card and save it.

    photo_position: 'left', 'right', or None to auto-alternate.
    seed: for reproducible bokeh patterns. None = random.
    """
    if photo_position is None:
        photo_position = _pick_photo_position()
    rng = random.Random(seed) if seed is not None else random.Random()

    # 1. Bokeh background
    bg = _make_bokeh_background(rng)

    # 2. LinkedIn badge top-left
    _draw_linkedin_badge(bg, x=40, y=40, size=64)

    # 3. Headshot (left or right) - returns text bounds
    text_left, text_right = _paste_headshot(bg, photo_position)

    # 4. Text panel
    _draw_text_panel(bg, dont_text, do_text, text_left, text_right)

    output_path = Path(output_path)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    bg.save(output_path, "PNG", optimize=True)
    return output_path


if __name__ == "__main__":
    print("Detected platform:", sys.platform)
    print("Font availability:")
    for style in ["bold", "regular", "italic", "bold_italic", "cursive"]:
        found = None
        for path in _font_candidates(style):
            if Path(path).exists():
                found = path
                break
        status = "✓" if found else "✗"
        print(f"  {status} {style}: {found or 'NOT FOUND'}")
    print()

    # Generate two samples - one with photo right, one with photo left
    out1 = make_card(
        dont_text="Pip install into your base env",
        do_text="One conda env per project, always",
        output_path=ROOT / "drafts" / "preview_card_right.png",
        photo_position="right",
        seed=42,
    )
    print(f"Saved: {out1}")

    out2 = make_card(
        dont_text="Normalize before train/test split",
        do_text="Fit on train only, then transform",
        output_path=ROOT / "drafts" / "preview_card_left.png",
        photo_position="left",
        seed=7,
    )
    print(f"Saved: {out2}")
